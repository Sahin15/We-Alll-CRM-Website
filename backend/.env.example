# Firebase Configuration (Required for Notifications)
# Get these values from Firebase Console → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database

# JWT
JWT_SECRET=your-jwt-secret-key

# Server
PORT=5000
NODE_ENV=production

# AWS S3 (if using file uploads)
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# Email Configuration (if using email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Frontend URL (for CORS)
FRONTEND_URL=https://your-frontend-domain.com

# Admin Email
ADMIN_EMAIL=admin@example.com

# Payroll V2 Engine (Milestone 4+ / R-track)
# Default when unset: false — dual-run may log V1 vs V2 diffs; persisted slips use V1.
# Only set to true after dual-run month sign-off (R3) and ENGINE_CUTOVER_RUNBOOK hard gates.
# Never commit true; use env secrets. Kill-switch: set false and restart (ENGINE_KILL_SWITCH.md).
# PAYROLL_V2_ENGINE=false

# Payroll period operation gates (R5)
# Default when unset: false — generate/export/mark-paid ignore period status.
# When true: generate/export require open|frozen; mark-paid requires locked; missing period blocks.
# PAYROLL_PERIOD_GATES=false

# Authorization V2 (optional — foundation phase)
# AUTHZ_SHADOW_MODE=true   # Log V2 vs legacy decision mismatches (keep ON during Phase 9)
# AUTHZ_V2_ENFORCE=false   # When true, enabled module flags block denied requests
#
# --- Phase 9 Wave 1 (staging start — low-risk read-mostly) ---
# Enable shadow + enforce, then turn on Wave 1 backend AND matching VITE_AUTHZ_V2_* on frontend:
# AUTHZ_SHADOW_MODE=true
# AUTHZ_V2_ENFORCE=true
# AUTHZ_V2_PROFILE=true
# AUTHZ_V2_SUPPORT=true
# AUTHZ_V2_DASHBOARD=true
# AUTHZ_V2_COMPANY=true
# AUTHZ_V2_REPORTS=true
#
# Remaining modules (enable one wave at a time — see docs/AUTHZ-V2-PHASE-9-ROLLOUT.md):
# AUTHZ_V2_WORKLOG=true
# AUTHZ_V2_ATTENDANCE=true
# AUTHZ_V2_LEAVE=true
# AUTHZ_V2_WFH=true
# AUTHZ_V2_TEAM=true
# AUTHZ_V2_HIRING=true
# AUTHZ_V2_PROJECTS=true
# AUTHZ_V2_WORK=true
# AUTHZ_V2_CRM=true
# AUTHZ_V2_PROCUREMENT=true
# AUTHZ_V2_BILLING=true
# AUTHZ_V2_FINANCE=true
# AUTHZ_V2_RESOURCES=true
# AUTHZ_V2_AUTH=true
#
# Check rollout progress: npm run authz:rollout-status
# API (admin): GET /api/authz/rollout-status
