# Development Environment Variables Template
# Copy this file to .env and fill in your development values
# NEVER commit .env files with real credentials!

# ======================
# Server Configuration
# ======================
NODE_ENV=development
PORT=5000

# ======================
# Database Configuration
# ======================
# MongoDB Atlas connection (use development database)
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@your-cluster.mongodb.net/your-dev-database?retryWrites=true&w=majority

# Alternative: Local MongoDB
# MONGO_URI=mongodb://localhost:27017/wealll-crm-dev

# ======================
# JWT Configuration
# ======================
# Use a development JWT secret (change for production)
JWT_SECRET=your_development_jwt_secret_min_32_characters
JWT_EXPIRE=30d

# ======================
# AWS S3 Configuration (Development)
# ======================
# Use development/test AWS credentials
AWS_ACCESS_KEY_ID=your_dev_aws_access_key
AWS_SECRET_ACCESS_KEY=your_dev_aws_secret_key
AWS_REGION=eu-north-1
AWS_S3_BUCKET_NAME=your-dev-bucket

# ======================
# CORS Configuration
# ======================
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ======================
# Development Settings
# ======================
DEBUG_MODE=true
LOG_LEVEL=debug

# ======================
# Email Configuration (Optional)
# ======================
# Email Provider: gmail, brevo, mailgun
EMAIL_PROVIDER=gmail

# Gmail Configuration (recommended for development)
GMAIL_USER=your_dev_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# Brevo (Sendinblue) Configuration
# BREVO_USER=your_brevo_email@domain.com
# BREVO_API_KEY=your_brevo_api_key

# Mailgun Configuration
# MAILGUN_SMTP_USER=postmaster@your-domain.mailgun.org
# MAILGUN_SMTP_PASSWORD=your_mailgun_smtp_password

# Email Settings
FROM_EMAIL=your_dev_email@gmail.com
COMPANY_NAME=We Alll

# Legacy email settings (for backward compatibility)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_dev_email@gmail.com
EMAIL_PASSWORD=your_dev_app_password

# ======================
# Firebase Configuration (Push Notifications)
# ======================
# Option 1: Full service account JSON (recommended for production)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project",...}

# Option 2: Individual fields (easier for development)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_CLIENT_ID=your_client_id

# Note: For development, you can also place firebase-service-account.json in backend root