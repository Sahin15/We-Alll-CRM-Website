# Firebase Configuration (Required for Notifications)
# Get these values from Firebase Console → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database

# JWT
JWT_SECRET=your-jwt-secret-key

# Server
PORT=5000
NODE_ENV=production

# AWS S3 (if using file uploads)
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# Email Configuration (if using email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Frontend URL (for CORS)
FRONTEND_URL=https://your-frontend-domain.com

# Admin Email
ADMIN_EMAIL=admin@example.com

# Authorization V2 (optional — foundation phase)
# AUTHZ_SHADOW_MODE=true   # Log V2 vs legacy decision mismatches
# AUTHZ_V2_ENFORCE=false   # When true, requirePermissionKey blocks denied requests
# AUTHZ_V2_PROFILE=true    # Enable profile module V2 enforcement (with AUTHZ_V2_ENFORCE)
# AUTHZ_V2_SUPPORT=true    # Enable support module V2 enforcement (with AUTHZ_V2_ENFORCE)
# AUTHZ_V2_DASHBOARD=true  # Enable dashboard module V2 enforcement (with AUTHZ_V2_ENFORCE)
# AUTHZ_V2_COMPANY=true    # Enable company module V2 enforcement (with AUTHZ_V2_ENFORCE)
# AUTHZ_V2_WORKLOG=true    # Enable work log module V2 enforcement (with AUTHZ_V2_ENFORCE)
# AUTHZ_V2_ATTENDANCE=true # Enable attendance module V2 enforcement (with AUTHZ_V2_ENFORCE)
# AUTHZ_V2_LEAVE=true     # Enable leave module V2 enforcement (with AUTHZ_V2_ENFORCE)
# AUTHZ_V2_WFH=true       # Enable WFH + work-on-leave V2 enforcement (with AUTHZ_V2_ENFORCE)
# AUTHZ_V2_TEAM=true      # Enable team (users/departments) V2 enforcement (with AUTHZ_V2_ENFORCE)
# AUTHZ_V2_HIRING=true    # Enable hiring module V2 enforcement (with AUTHZ_V2_ENFORCE)
# AUTHZ_V2_PROJECTS=true  # Enable projects module V2 enforcement (with AUTHZ_V2_ENFORCE)
# AUTHZ_V2_WORK=true      # Enable work items module V2 enforcement (with AUTHZ_V2_ENFORCE)
# AUTHZ_V2_CRM=true       # Enable CRM (leads/clients/raw data) V2 enforcement (with AUTHZ_V2_ENFORCE)
# AUTHZ_V2_PROCUREMENT=true # Enable procurement module V2 enforcement (with AUTHZ_V2_ENFORCE)
#
# Staging soak (profile pilot) — enable shadow first, enforce after 7 days:
# AUTHZ_SHADOW_MODE=true
# AUTHZ_V2_PROFILE=true
# AUTHZ_V2_ENFORCE=false
