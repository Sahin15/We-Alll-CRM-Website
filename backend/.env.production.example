# Production Environment Configuration
# Copy this file to .env and fill in the values

# ======================
# Server Configuration
# ======================
NODE_ENV=production
PORT=5000

# ======================
# Database Configuration
# ======================
# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Alternative: Self-hosted MongoDB
# MONGO_URI=mongodb://<username>:<password>@localhost:27017/<database>?authSource=admin

# ======================
# JWT Configuration
# ======================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-min-32-characters
JWT_EXPIRE=7d

# ======================
# AWS S3 Configuration
# ======================
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-bucket-name

# ======================
# Email Configuration
# ======================
# Email Provider: gmail, brevo, mailgun
EMAIL_PROVIDER=gmail

# Gmail Configuration (recommended)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# Brevo (Sendinblue) Configuration
# BREVO_USER=your-brevo-email@domain.com
# BREVO_API_KEY=your_brevo_api_key

# Mailgun Configuration
# MAILGUN_SMTP_USER=postmaster@your-domain.mailgun.org
# MAILGUN_SMTP_PASSWORD=your_mailgun_smtp_password

# Email Settings
FROM_EMAIL=noreply@yourdomain.com
COMPANY_NAME=We Alll

# Legacy email settings (for backward compatibility)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@yourdomain.com

# Alternative: SendGrid
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USER=apikey
# EMAIL_PASSWORD=your-sendgrid-api-key

# Alternative: AWS SES
# EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
# EMAIL_PORT=587
# EMAIL_USER=your-ses-smtp-username
# EMAIL_PASSWORD=your-ses-smtp-password

# ======================
# CORS Configuration
# ======================
# Frontend URL(s) - comma separated for multiple origins
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# ======================
# Rate Limiting
# ======================
# Time window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window (default: 100)
RATE_LIMIT_MAX_REQUESTS=100

# Auth rate limit (default: 5 attempts per 15 minutes)
AUTH_RATE_LIMIT_MAX=5

# Work item creation rate limit (default: 10 per minute)
CREATE_WORK_ITEM_RATE_LIMIT_MAX=10

# ======================
# Session Configuration
# ======================
SESSION_SECRET=your-session-secret-min-32-characters
SESSION_TIMEOUT=86400000

# ======================
# File Upload Configuration
# ======================
# Maximum file size in bytes (default: 10MB)
MAX_FILE_SIZE=10485760

# Allowed file types (comma separated)
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ======================
# Logging Configuration
# ======================
# Log level: error, warn, info, debug
LOG_LEVEL=info

# Log file path
LOG_FILE_PATH=./logs/app.log

# ======================
# Notification Configuration
# ======================
# Enable/disable email notifications
ENABLE_EMAIL_NOTIFICATIONS=true

# Enable/disable in-app notifications
ENABLE_IN_APP_NOTIFICATIONS=true

# Notification check interval (in minutes)
NOTIFICATION_CHECK_INTERVAL=5

# ======================
# Cron Jobs Configuration
# ======================
# Enable/disable scheduled jobs
ENABLE_CRON_JOBS=true

# Due soon notification hours before due date
DUE_SOON_HOURS=24

# Overdue check schedule (cron format: "0 9 * * *" = 9 AM daily)
OVERDUE_CHECK_SCHEDULE=0 9 * * *

# ======================
# Security Configuration
# ======================
# Enable/disable audit logging
ENABLE_AUDIT_LOGGING=true

# Audit log file path
AUDIT_LOG_PATH=./logs/audit.log

# Password minimum length
PASSWORD_MIN_LENGTH=8

# Password require special characters
PASSWORD_REQUIRE_SPECIAL=true

# Maximum login attempts before lockout
MAX_LOGIN_ATTEMPTS=5

# Account lockout duration (in minutes)
LOCKOUT_DURATION=30

# ======================
# Performance Configuration
# ======================
# Enable query result caching
ENABLE_QUERY_CACHE=true

# Cache TTL in seconds
CACHE_TTL=300

# Database connection pool size
DB_POOL_SIZE=10

# ======================
# Feature Flags
# ======================
# Enable/disable specific features
ENABLE_BULK_OPERATIONS=true
ENABLE_CALENDAR_VIEW=true
ENABLE_ANALYTICS=true
ENABLE_EXPORT=true

# ======================
# Third-Party Integrations
# ======================
# Google Analytics (optional)
GOOGLE_ANALYTICS_ID=

# Sentry Error Tracking (optional)
SENTRY_DSN=

# Slack Webhook (optional)
SLACK_WEBHOOK_URL=

# ======================
# Application URLs
# ======================
# Frontend URL
FRONTEND_URL=https://yourdomain.com

# Backend API URL
API_URL=https://api.yourdomain.com

# ======================
# Maintenance Mode
# ======================
# Enable maintenance mode
MAINTENANCE_MODE=false

# Maintenance message
MAINTENANCE_MESSAGE=System is currently under maintenance. Please try again later.

# ======================
# Development/Debug
# ======================
# Enable debug mode (should be false in production)
DEBUG_MODE=false

# Enable SQL query logging (should be false in production)
LOG_QUERIES=false

# ======================
# Backup Configuration
# ======================
# Backup schedule (cron format)
BACKUP_SCHEDULE=0 2 * * *

# Backup retention days
BACKUP_RETENTION_DAYS=30

# Backup storage path
BACKUP_PATH=/backups

# ======================
# Notes
# ======================
# 1. Never commit this file with actual values to version control
# 2. Keep this file secure and restrict access
# 3. Use strong, unique values for all secrets
# 4. Rotate secrets regularly
# 5. Use environment-specific values for each deployment
# 6. Document any custom environment variables added
