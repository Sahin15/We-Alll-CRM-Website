# UAT environment — uat.wealll.cloud (Hostinger VPS, port 5001)
# Copy to /var/www/crm-uat/backend/.env on the server. NEVER copy production .env.

APP_ENV=uat
NODE_ENV=production
PORT=5001

# Isolated Atlas database (same cluster, different db name)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/crm-uat

# Different JWT secret from production
JWT_SECRET=change-me-uat-only-secret

FRONTEND_URL=https://uat.wealll.cloud

# Payroll — keep V2 and period gates off for safe QA
PAYROLL_V2_ENGINE=false
PAYROLL_PERIOD_GATES=false

# Email — leave unset or use sandbox; app skips real sends when APP_ENV=uat
# EMAIL_PROVIDER=brevo
# BREVO_USER=
# BREVO_API_KEY=
# FROM_EMAIL=noreply@demo.wealll.local

# Firebase — optional test project; FCM push is skipped when APP_ENV=uat
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=

# S3 — use uat/ prefix for uploads (configure bucket policy as needed)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-bucket-name
# Optional: AWS_S3_PREFIX=uat/

COMPANY_NAME=We Alll (UAT)
