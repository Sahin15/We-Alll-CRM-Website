# Frontend Environment Variables
# Replace with your actual production API URL
VITE_API_URL=https://yourdomain.com/api

# WebSocket URL for real-time updates
VITE_WS_URL=wss://yourdomain.com/ws

# Authorization V2 — Profile pilot (set true on staging to test)
# VITE_AUTHZ_V2_PROFILE=true
# VITE_AUTHZ_V2_SUPPORT=true
# VITE_AUTHZ_V2_DASHBOARD=true
# VITE_AUTHZ_V2_COMPANY=true
#
# Staging soak (profile pilot):
# VITE_AUTHZ_V2_PROFILE=true